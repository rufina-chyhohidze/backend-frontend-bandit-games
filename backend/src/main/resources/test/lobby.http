###############################################
### Create Lobby
###############################################
POST http://localhost:8080/api/lobby/create
Content-Type: application/json

{
  "playerId": "11111111-1111-1111-1111-111111111111"
}

###
@lobbyId = 6ab2fe43-6baa-49da-8f23-6cfe638c4a82 
###############################################
### Add Player to Lobby
### Replace {lobbyId} with actual ID from "createLobby"
###############################################
POST http://localhost:8080/api/lobby/{{lobbyId}}/add-player?playerId=22222222-2222-2222-2222-222222222222

###

###############################################
### Remove Player From Lobby
###############################################
POST http://localhost:8080/api/lobby/{{lobbyId}}/leave-lobby?playerId=22222222-2222-2222-2222-222222222222

###

###############################################
### Choose Game for the Lobby
###############################################
POST http://localhost:8080/api/lobby/{{lobbyId}}/choose-game?gameId=33333333-3333-3333-3333-333333333333

###

###############################################
### Start Game in Lobby (303 redirect)
###############################################
POST http://localhost:8080/api/lobby/{{lobbyId}}/start-game

###

###############################################
### Close Lobby
###############################################
DELETE http://localhost:8080/api/lobby/{{lobbyId}}

###
