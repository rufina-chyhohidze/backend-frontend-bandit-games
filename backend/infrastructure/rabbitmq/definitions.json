{
  "users": [
    {
      "name": "user",
      "password": "password",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "user",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "connect4.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "connect4.game.created",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "connect4.move.made",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "vhost": "/",
      "source": "connect4.events",
      "destination": "connect4.game.created",
      "destination_type": "queue",
      "routing_key": "connect4.game.created.*",
      "arguments": {}
    },
    {
      "vhost": "/",
      "source": "connect4.events",
      "destination": "connect4.move.made",
      "destination_type": "queue",
      "routing_key": "connect4.move.made.*",
      "arguments": {}
    }
  ]
}
